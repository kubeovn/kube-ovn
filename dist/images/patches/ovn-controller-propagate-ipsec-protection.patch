+/* The node owner installs independent guards before publishing this lease.
+ * Mark every OVN-created tunnel output, even paths without IKE peer identity.
+ * Such paths remain blocked while armed; this does not add IPsec support. */
+static void
+add_protection_options(struct smap *options,
+                       const struct ovsrec_open_vswitch_table *ovs_table,
+                       bool ipsec)
+{
+    const struct ovsrec_open_vswitch *cfg =
+        ovsrec_open_vswitch_table_first(ovs_table);
+    if (!cfg) {
+        return;
+    }
+    unsigned int mark = smap_get_uint(&cfg->external_ids,
+                                      "ovn-ipsec-protection-mark", 0);
+    unsigned int reqid = smap_get_uint(&cfg->external_ids,
+                                       "ovn-ipsec-protection-reqid", 0);
+    if (mark && reqid) {
+        smap_add_format(options, "egress_pkt_mark", "%u", mark);
+        if (ipsec) {
+            smap_add_format(options, "ipsec_mark_out", "%u/0xffffffff", mark);
+            smap_add_format(options, "ipsec_reqid", "%u", reqid);
+        }
+    }
+}
