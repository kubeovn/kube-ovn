From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: zhangzujian <zhangzujian.7@gmail.com>
Date: Tue, 29 Sep 2026 03:00:00 +0000
Subject: [PATCH] northd: preserve router-owned ARP and ND with flood suppression

Keep router-owned ARP/ND requests above the priority-90 flood suppression
rule at priority 95 and their GARP exceptions at priority 105. This preserves
NAT and LB address resolution without allowing unknown IPv6 NS to hit the
multicast snooping flood rules.

Signed-off-by: zhangzujian <zhangzujian.7@gmail.com>
---

diff --git a/northd/en-global-config.c b/northd/en-global-config.c
index 9463caf91..1a719f03d 100644
--- a/northd/en-global-config.c
+++ b/northd/en-global-config.c
@@ -626,0 +627,5 @@ check_nb_options_out_of_sync(
+    if (config_out_of_sync(&nb->options, &config_data->nb_options,
+                           "bcast_arp_nd_req_flood", false)) {
+        return true;
+    }
+
diff --git a/northd/northd.c b/northd/northd.c
index f6b778222..478a1311d 100644
--- a/northd/northd.c
+++ b/northd/northd.c
@@ -117,0 +118,2 @@ static bool ls_dnat_mod_dl_dst = false;
+static bool bcast_arp_nd_req_flood = false;
+
@@ -9402,0 +9405,8 @@ build_lswitch_rport_arp_req_flow(
+    /* Keep router-owned ARP/ND above the priority-90 flood suppression
+     * rule. Lowering that rule would expose IPv6 NS to multicast snooping
+     * floods at priority 85. The GARP exception below uses priority + 10.
+     */
+    if (!bcast_arp_nd_req_flood && od->has_unknown) {
+        priority = 95;
+    }
+
@@ -10021,0 +10032,6 @@ build_lswitch_lflows_l2_unknown(struct ovn_datapath *od,
+        if (!bcast_arp_nd_req_flood) {
+            ovn_lflow_add(lflows, od, S_SWITCH_IN_L2_LKUP, 90,
+                          "(eth.bcast && arp.op == 1) || nd_ns_mcast",
+                          "next;",
+                          lflow_ref);
+        }
@@ -20261,0 +20278,2 @@ ovnnb_db_run(struct northd_input *input_data,
+    bcast_arp_nd_req_flood = smap_get_bool(input_data->nb_options,
+                                        "bcast_arp_nd_req_flood", false);
