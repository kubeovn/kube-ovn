diff --git a/bfdd-control.cpp b/bfdd-control.cpp
index 753b82b..2edc780 100755
--- a/bfdd-control.cpp
+++ b/bfdd-control.cpp
@@ -8,0 +9 @@
+#include "TimeSpec.h"
@@ -12,0 +14 @@
