@@ -15 +16,0 @@
-#include <unistd.h>
@@ -18,0 +20,129 @@ using namespace std;
+namespace
+{
+const uint32_t ControlRequestTimeoutMs = 5000;
+
+bool WaitForSocket(int fd, bool waitForWrite, const TimeSpec &deadline, const char *operation)
+{
+  while (true)
+  {
+    TimeSpec now = TimeSpec::MonoNow();
+    if (now >= deadline)
+    {
+      fprintf(stderr, "Timed out while %s.\n", operation);
+      errno = ETIMEDOUT;
+      return false;
+    }
+
+    TimeSpec waitSpan = deadline - now;
+    struct timeval waitTime;
+    waitTime.tv_sec = waitSpan.tv_sec;
+    waitTime.tv_usec = waitSpan.tv_nsec / TimeSpec::NSecPerUs;
+
+    fd_set readSet;
+    fd_set writeSet;
+    FD_ZERO(&readSet);
+    FD_ZERO(&writeSet);
+    FD_SET(fd, waitForWrite ? &writeSet : &readSet);
+
+    int result = select(fd + 1, &readSet, &writeSet, NULL, &waitTime);
+    if (result > 0)
+      return true;
+    if (result == 0)
+      continue;
+    if (errno != EINTR)
+    {
+      fprintf(stderr, "Error while %s: %s\n", operation, ErrnoToString());
+      return false;
+    }
+  }
+}
+
+bool SendAll(Socket &socket, const void *message, size_t messageSize, const TimeSpec &deadline)
+{
+  const void *remainingMessage = message;
+  size_t remainingLength = messageSize;
+
+  while (remainingLength)
+  {
+    if (TimeSpec::MonoNow() >= deadline)
+    {
+      errno = ETIMEDOUT;
+      return false;
+    }
+
+    size_t previousLength = remainingLength;
+    if (socket.SendStream(&remainingMessage, &remainingLength, MSG_DONTWAIT | MSG_NOSIGNAL))
+    {
+      if (remainingLength < previousLength)
+        continue;
+    }
+    else
+    {
+      int error = socket.GetLastError();
+      if (error != EAGAIN && error != EWOULDBLOCK && error != EINTR)
+        return false;
+      if (error == EINTR)
+        continue;
+    }
+
+    if (!WaitForSocket(socket, true, deadline, "sending command to beacon"))
+      return false;
+  }
