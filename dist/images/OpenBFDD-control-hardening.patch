diff --git a/bfdd-control.cpp b/bfdd-control.cpp
index 753b82b..d955cd0 100755
--- a/bfdd-control.cpp
+++ b/bfdd-control.cpp
@@ -8,0 +9 @@
+#include "TimeSpec.h"
@@ -12,0 +14 @@
+#include <sys/select.h>
@@ -15 +16,0 @@
-#include <unistd.h>
@@ -18,0 +20,108 @@ using namespace std;
+namespace
+{
+const uint32_t ControlRequestTimeoutMs = 5000;
+
+bool WaitForSocket(int fd, bool waitForWrite, const TimeSpec &deadline, const char *operation)
+{
+  while (true)
+  {
+    TimeSpec now = TimeSpec::MonoNow();
+    if (now >= deadline)
+    {
+      fprintf(stderr, "Timed out while %s.\n", operation);
+      errno = ETIMEDOUT;
+      return false;
+    }
+
+    TimeSpec waitSpan = deadline - now;
+    struct timeval waitTime;
+    waitTime.tv_sec = waitSpan.tv_sec;
+    waitTime.tv_usec = waitSpan.tv_nsec / TimeSpec::NSecPerUs;
+
+    fd_set readSet;
+    fd_set writeSet;
+    FD_ZERO(&readSet);
+    FD_ZERO(&writeSet);
+    FD_SET(fd, waitForWrite ? &writeSet : &readSet);
+
+    int result = select(fd + 1, &readSet, &writeSet, NULL, &waitTime);
+    if (result > 0)
+      return true;
+    if (result == 0)
+      continue;
+    if (errno != EINTR)
+    {
+      fprintf(stderr, "Error while %s: %s\n", operation, ErrnoToString());
+      return false;
+    }
+  }
+}
+
+bool SendAll(Socket &socket, const void *message, size_t messageSize, const TimeSpec &deadline)
+{
+  const void *remainingMessage = message;
+  size_t remainingLength = messageSize;
+
+  while (remainingLength)
+  {
+    if (TimeSpec::MonoNow() >= deadline)
+    {
+      errno = ETIMEDOUT;
+      return false;
+    }
+
+    size_t previousLength = remainingLength;
+    if (socket.SendStream(&remainingMessage, &remainingLength, MSG_DONTWAIT | MSG_NOSIGNAL))
+    {
+      if (remainingLength < previousLength)
+        continue;
+    }
+    else
+    {
+      int error = socket.GetLastError();
+      if (error != EAGAIN && error != EWOULDBLOCK && error != EINTR)
+        return false;
+      if (error == EINTR)
+        continue;
+    }
+
+    if (!WaitForSocket(socket, true, deadline, "sending command to beacon"))
+      return false;
+  }
+  return true;
+}
+
+bool ReadReply(Socket &socket, vector<char> &buffer, const char *outPrefix,
+               const TimeSpec &deadline)
+{
+  bool atLineStart = true;
+
+  while (true)
+  {
+    if (!WaitForSocket(socket, false, deadline, "waiting for beacon reply"))
+      return false;
+
+    ssize_t received = recv(socket, &buffer.front(), buffer.size(), MSG_DONTWAIT);
+    if (received == 0)
+      return true;
+    if (received < 0)
+    {
+      if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)
+        continue;
+      fprintf(stderr, "Connection failed. Partial completion may have occurred: %s\n",
+              ErrnoToString());
+      return false;
+    }
+
+    for (ssize_t i = 0; i < received; i++)
+    {
+      if (atLineStart && outPrefix)
+        fputs(outPrefix, stdout);
+      char value = buffer[size_t(i)];
+      fputc(value, stdout);
+      atLineStart = value == '\n';
+    }
+  }
+}
+}
