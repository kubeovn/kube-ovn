+  struct StatusOperation
+  {
+    StatusOperation(CommandProcessorImp *commandProcessor, bool allSessions,
+                    int level, const SessionID &sessionId) :
+      processor(commandProcessor),
+      allSessions(allSessions),
+      result(0),
+      wasShuttingDown(false),
+      exceptionThrown(false),
+      completed(false),
+      lock(true),
+      condition(true, true),
+      references(2)
+    {
+      multiInfo.level = level;
+      singleInfo.level = level;
+      singleInfo.sessionId = sessionId;
+    }
+
+    CommandProcessorImp *processor;
+    bool allSessions;
+    MultiStatusCallbackInfo multiInfo;
+    SingleStatusCallbackInfo singleInfo;
+    intptr_t result;
+    bool wasShuttingDown;
+    bool exceptionThrown;
+    bool completed;
+    TimeSpec callbackStarted;
+    TimeSpec callbackCompleted;
+    QuickLock lock;
+    WaitCondition condition;
+    size_t references;
+  };
+
+  static void releaseStatusOperation(StatusOperation *operation)
+  {
+    bool destroy;
+    {
+      AutoQuickLock lock(operation->lock, true);
+      LogAssert(operation->references > 0);
+      operation->references--;
+      destroy = operation->references == 0;
+    }
+    if (destroy)
+      delete operation;
+  }
+
+  static void handleStatusOperation(Beacon *beacon, void *userdata)
+  {
+    StatusOperation *operation = reinterpret_cast<StatusOperation *>(userdata);
+    operation->callbackStarted = TimeSpec::MonoNow();
+
+    if (beacon->IsShutdownRequested())
+      operation->wasShuttingDown = true;
+    else
+    {
+      try
+      {
+        if (operation->allSessions)
+          operation->processor->doHandleMultiStatus(beacon, &operation->multiInfo);
+        else
+          operation->result = operation->processor->doHandleSingleStatus(beacon, &operation->singleInfo);
+      }
+      catch (std::exception &e)
+      {
+        operation->exceptionThrown = true;
+        gLog.Message(Log::Error, "Status operation failed due to exception: %s", e.what());
+      }
+      catch (...)
+      {
+        operation->exceptionThrown = true;
+        gLog.Message(Log::Error, "Status operation failed due to an unknown exception.");
+      }
+    }
+
+    operation->callbackCompleted = TimeSpec::MonoNow();
+    {
+      AutoQuickLock lock(operation->lock, true);
+      operation->completed = true;
+      lock.SignalAndUnlock(operation->condition);
+    }
+    releaseStatusOperation(operation);
+  }
+
+  bool waitForStatusOperation(StatusOperation *operation)
+  {
+    TimeSpec deadline = TimeSpec::MonoNow() +
+                        TimeSpec(TimeSpec::Millisec, ControlOperationTimeoutMs);
+    AutoQuickLock lock(operation->lock, true);
+
+    while (!operation->completed)
+    {
+      TimeSpec remaining = deadline - TimeSpec::MonoNow();
+      int64_t remainingNs = remaining.ToNanoseconds();
+      if (remainingNs <= 0)
+      {
+        m_operationTimedOut = true;
+        return false;
+      }
+
+      uint32_t waitMs = uint32_t((remainingNs + TimeSpec::NSecPerMs - 1) /
+                                 TimeSpec::NSecPerMs);
+      waitMs = min(waitMs, uint32_t(100));
+      if (lock.LockWait(operation->condition, waitMs) < 0)
+      {
+        messageReply("Unable to complete status request because waiting failed.\n");
+        return false;
+      }
+    }
+
+    m_callbackStarted = operation->callbackStarted;
+    m_callbackCompleted = operation->callbackCompleted;
+    if (operation->exceptionThrown)
+    {
+      messageReply("Unable to complete status request because an exception was thrown.\n");
+      return false;
+    }
+    if (operation->wasShuttingDown)
+    {
+      messageReply("Unable to complete status request because the beacon is shutting down.\n");
+      return false;
+    }
+    return true;
+  }
+
+  StatusOperation *runStatusOperation(bool allSessions, int level,
+                                      const SessionID &sessionId)
+  {
+    StatusOperation *operation =
+        new(std::nothrow) StatusOperation(this, allSessions, level, sessionId);
+    if (!operation)
+    {
+      messageReply("Unable to complete status request because memory allocation failed.\n");
+      return NULL;
+    }
+
+    m_operationQueued = TimeSpec::MonoNow();
+    if (!m_beacon->QueueOperation(handleStatusOperation, operation,
+                                  false, &m_operationQueueDepth))
+    {
+      releaseStatusOperation(operation);
+      releaseStatusOperation(operation);
+      messageReply("Unable to complete status request because it could not be queued or signaled.\n");
+      return NULL;
+    }
+
+    if (!waitForStatusOperation(operation))
+    {
+      releaseStatusOperation(operation);
+      return NULL;
+    }
+    return operation;
+  }
+
