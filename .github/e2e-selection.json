{
  "schemaVersion": 1,
  "expectedRunnerJobs": 12,
  "forceFull": false,
  "fullThreshold": 3,
  "productionPrefixes": [
    "cmd/",
    "fastpath/",
    "pkg/",
    "versions/"
  ],
  "smoke": [
    {
      "job": "k8s-conformance-e2e",
      "ip-family": "ipv4",
      "mode": "overlay"
    },
    {
      "job": "k8s-conformance-e2e",
      "ip-family": "ipv4",
      "mode": "underlay"
    },
    {
      "job": "k8s-netpol-e2e",
      "ip-family": "ipv4",
      "np-enforcement": "standard"
    }
  ],
  "fullPaths": [
    ".github/e2e-selection.json",
    ".github/workflows/**",
    "hack/e2e_selector.py",
    "hack/e2e_control.py",
    "hack/test_e2e_selector.py",
    "hack/test_e2e_control.py",
    "Makefile",
    "VERSION",
    "makefiles/**",
    "go.mod",
    "go.sum",
    "dist/images/**",
    "charts/**",
    "hack/ci-check-crash.sh",
    "hack/gen-crd.sh",
    "hack/update-codegen.sh",
    "hack/mockgen.sh",
    "hack/modelgen.sh",
    "pkg/apis/**",
    "pkg/client/**",
    "pkg/controller/**",
    "pkg/informer/**",
    "pkg/daemon/**",
    "pkg/ipam/**",
    "pkg/net/**",
    "pkg/netconf/**",
    "pkg/ovs/**",
    "pkg/ovsdb/**",
    "pkg/util/**",
    "test/e2e/framework/**",
    "test/e2e/single-replica/**",
    "cmd/cni/**",
    "cmd/kubectl-ko/**",
    "pkg/ko/**",
    "cmd/controller/**",
    "cmd/daemon/**",
    "cmd/cmdmain.go",
    "yamls/**",
    "hack/network_e2e_diagnostics.py",
    "test/e2e/kubevirt/**",
    "test/e2e/bgp/**",
    "pkg/speaker/**",
    "cmd/speaker/**",
    "test/e2e/multus/**",
    "test/e2e/non-primary-cni/**",
    "test/e2e/cilium-chaining/**",
    "yamls/cilium-chaining.yaml",
    "test/e2e/lb-svc/**",
    "test/e2e/kube-ovn/switch_lb_rule/**",
    "test/e2e/metallb/**",
    "pkg/controller/service.go",
    "pkg/controller/switch_lb_rule.go",
    "pkg/controller/vpc_dns.go",
    "charts/**",
    "makefiles/talos.mk",
    "talos/**",
    "test/e2e/ha/**",
    "test/e2e/kamaji/**",
    "hack/kamaji-e2e.sh",
    "hack/kamaji-e2e-test.sh",
    "test/e2e/ovn-ic/**",
    "test/e2e/submariner/**",
    "pkg/controller/ovn_ic_controller.go",
    "pkg/controller/ovn_ic_controller_test.go",
    "test/e2e/vpc-egress-gateway/**",
    "test/e2e/iptables-vpc-nat-gw/**",
    "test/e2e/ovn-vpc-nat-gw/**",
    "test/e2e/iptables-eip-qos/**",
    "test/e2e/vip/**",
    "pkg/controller/vpc_egress_gateway*.go",
    "pkg/controller/vpc_nat_gateway*.go",
    "pkg/controller/ovn_*nat*.go",
    "pkg/controller/iptables_*.go",
    "pkg/controller/ovn_eip.go",
    "pkg/controller/ovn_fip.go",
    "pkg/controller/ovn_snat.go",
    "pkg/controller/ovn_dnat.go",
    "test/e2e/webhook/**",
    "test/e2e/ipsec/**",
    "test/e2e/security/**",
    "pkg/webhook/**",
    "cmd/webhook/**",
    "pkg/controller/ipsec*.go",
    "test/e2e/kube-ovn/**",
    "test/e2e/connectivity/**",
    "hack/test_network_e2e_diagnostics.py"
  ],
  "pathRules": [
    {
      "patterns": [
        "test/e2e/k8s-network/**"
      ],
      "groups": [
        "core",
        "policy"
      ],
      "owner": "networking-e2e",
      "reason": "Kubernetes networking conformance and policy suites"
    },
    {
      "patterns": [
        "test/e2e/cnp-domain/**",
        "test/e2e/anp-domain/**"
      ],
      "groups": [
        "policy"
      ],
      "owner": "networking-e2e",
      "reason": "policy test changes require Kubernetes Network Policy coverage"
    },
    {
      "patterns": [
        "pkg/controller/network_policy*.go",
        "pkg/controller/admin_network_policy*.go"
      ],
      "groups": [
        "policy"
      ],
      "owner": "networking-e2e",
      "reason": "network policy reconciliation"
    },
    {
      "patterns": [
        "pkg/controller/service.go"
      ],
      "groups": [
        "core"
      ],
      "owner": "networking-e2e",
      "reason": "Service and load balancer reconciliation"
    }
  ],
  "groups": {
    "core": {
      "jobs": [
        {
          "id": "k8s-conformance-e2e",
          "matrix": {
            "ip-family": [
              "ipv4",
              "ipv6",
              "dual"
            ],
            "mode": [
              "overlay",
              "underlay"
            ]
          }
        }
      ]
    },
    "policy": {
      "jobs": [
        {
          "id": "k8s-netpol-e2e",
          "matrix": {
            "ip-family": [
              "ipv4",
              "ipv6",
              "dual"
            ],
            "np-enforcement": [
              "standard",
              "lax"
            ]
          }
        }
      ]
    }
  }
}
